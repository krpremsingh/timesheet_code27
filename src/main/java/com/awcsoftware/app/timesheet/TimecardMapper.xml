<!-- Start of Update Operations -->
	<update id="updateTimecardInfo" parameterType="TimecardInfo"
		keyProperty="tcId">
		UPDATE TimecardInfo SET status=#{status}, lastModifiedOn=now()
		WHERE tcId=#{tcId} and empId=#{empId}
	</update>

	<update id="updateTimecardInfoHour" parameterType="TimecardInfo"
		keyProperty="tcId">
		UPDATE TimecardInfo SET totalHours = #{totalHours}
		WHERE tcId=#{tcId} and empId=#{empId}
	</update>


	<update id="updateTimecardDayInfo"
		parameterType="TimecardDayInfo" useGeneratedKeys="true"
		keyProperty="tcdId">
		UPDATE TimeCardDayInfo SET
		status = #{status},
		lastModifiedOn = now()
		WHERE tcdId=#{tcdId} and tcId = #{tcId} and
		workingDate= #{workingDate}
	</update>

	<update id="updateTimecardDayHourInfo"
		parameterType="TimecardDayInfo" useGeneratedKeys="true"
		keyProperty="tcdId">
		UPDATE TimeCardDayInfo SET
		status = #{status},
		totalWeekWorkHours = #{totalWeekWorkHours}		
		WHERE tcdId=#{tcdId} and tcId = #{tcId} and
		workingDate= #{workingDate}
	</update>

	<update id="updateTimecardDayDetails"
		parameterType="TimecardDayDetails" useGeneratedKeys="true"
		keyProperty="tcddId">
		UPDATE TimecardDayDetails SET
		projectId=#{projectId},
		activityId=#{activityId},
		location=#{location},
		startTime=#{startTime},
		endTime=#{endTime},
		workingHours=#{workingHours},
		status	=#{status},
		taskDetails=#{taskDetails},
		lastModifiedOn = now()
		WHERE tcddId=#{tcddId} and tcdId=#{tcdId} and tcId = #{tcId} 
	</update>

<!-- End of Update Operations -->

<!-- Queries writted for validation on Timesheet -->

	<select id="isCurrentTimecardExist"
		parameterType="TimecardInfo" resultType="int">
		select ifnull(
		(select tcId from TimecardInfo where empId=#{empId} and tcId =#{tcId}
		),-1) from dual;
	</select>

	<select id="isDataForCurrentWeekExists"
		parameterType="TimecardInfo" resultType="int">
		select ifnull(
		(select tcId from TimecardInfo where empId=#{empId} and
		(weekStart between #{weekStart} and #{weekEnd})
		),-1) from dual;
	</select>

	<select id="isDataForCurrentDateExists"
		parameterType="TimecardDayInfo" resultType="int">
		select ifnull(
		(select tcdId from TimecardDayInfo where tcId = #{tcId} and 
		workingDate=#{workingDate} limit 0,1),-1) from dual;
	</select>

	<select id="isDataForCurrentDateTimeExists"
		parameterType="TimecardDayDetails" resultType="int">

		select ifnull((select tcddId from TimecardDayDetails where tcddId not in (#{tcddId}) and  tcdId=#{tcdId} and tcId = #{tcId} and
		starttime between #{startTime} and #{endTime}
		union
		select tcddId from TimecardDayDetails where tcddId  not in (#{tcddId}) and  tcdId=#{tcdId} and tcId = #{tcId} and 
		endtime between #{startTime} and #{endTime}  limit 0,1),-1) from dual
	</select>

	<select id="isDataForCurrentTimecardExists"
		parameterType="TimecardDayDetails" resultType="int">

		select ifnull((select tcddId from TimecardDayDetails where tcId = #{tcId} and
		starttime between #{startTime} and #{endTime}
		union
		select tcddId from TimecardDayDetails where tcId = #{tcId} and 
		endtime between #{startTime} and #{endTime} limit 0,1),-1) from dual
	</select>

<!-- Select query to show data on view page for logged in employee -->
	<select id="getTimecardView" parameterType="int"
		resultType="TimeCardView">
		select tcId,ifnull(weekStart,' ') as
		weekstartDT,ifnull(weekEnd,' ') as weekEndDT, ifnull(status,' ') as
		status,
		ifnull(concat(date_format(weekStart,'%d %b'),' to
		',date_format(weekend,'%d %b')),' ') WeekPeriod,
		ifnull(totalHours,' ')
		totalHour,ifnull(status,' ') statusGrid	from TimecardInfo tcsi where
		empId=#{empId};
	</select>

	<select id="getTimecardDetailView" resultMap="TimecardDayInfoViewMap">
			select a.tcdid,projectId ,activityId ,location ,taskDetails ,
			concat(substr(dayname(workingdate),1,3),' ',date_format(workingdate,'%b %d')) , 
			sum(workingHours) from timecarddayinfo a inner join timecarddaydetails b 
			on a.tcid=b.tcid and a.tcdid=b.tcdid  where a.tcid=#{tcId} group by 1,2,3,4;
	</select>

	<select id="getTimecardByManager" parameterType="int" resultType="TimecardInfo">
	select  e.empId,e.firstName,ti.totalHours,ti.status,ti.weekStart,ti.weekEnd,tad.comments,tad.status from TimeCardApprovalDetails tad,EmployeeInfo e inner join TimeCardSummaryInfo ti on ti.empId=e.empId where tad.approverId=#{approverId};
	</select>

</mapper> 
 
 
