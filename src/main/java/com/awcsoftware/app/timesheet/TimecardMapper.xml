<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="TimecardMapper">
	<cache />
	<resultMap id="TimecardInfoMap" type="TimecardInfo">
		<result column="tcId" property="tcId" jdbcType="INTEGER" />
		<result column="empId" property="empId" jdbcType="INTEGER" />
		<result column="weekStart" property="weekStart" jdbcType="DATE" />
		<result column="weekEnd" property="weekEnd" jdbcType="DATE" />
		<result column="totalHours" property="totalHours"
			jdbcType="DECIMAL" />
		<result column="status" property="status" jdbcType="VARCHAR" />
		<result column="addedOn" property="addedOn" jdbcType="DATE" />
		<result column="lastModifiedOn" property="lastModifiedOn"
			jdbcType="DATE" />
		<collection property="timecardDetails"
			ofType="com.awcsoftware.app.timesheet.TimecardInfo"
			select="getTimecardById" column="tcId">
			<id column="tcdId" property="tcdId" />
		</collection>

	</resultMap>

	<resultMap id="TimecardDayInfoMap" type="TimecardDayInfo">		
		<id column="tcdId" property="tcdId" jdbcType="INTEGER" />
		<result column="tcId" property="tcId" jdbcType="INTEGER" />
		<result column="workingDate" property="workingDate"
			jdbcType="DATE" />
		<result column="workingDay" property="workingDay"
			jdbcType="VARCHAR" />
		<result column="totalWeekWorkHours" property="totalWeekWorkHours"
			jdbcType="DECIMAL" />
		<result column="status" property="workingHours"
			jdbcType="VARCHAR" />
		<result column="addedOn" property="addedOn" jdbcType="DATE" />
		<result column="lastModifiedOn" property="lastModifiedOn"
			jdbcType="DATE" />
	</resultMap>

	<resultMap id="TimecardDayDetailsMap" type="TimecardDayDetails">		
		<id column="tcddId" property="tcddId" jdbcType="INTEGER" />
		<result column="tcdId" property="tcdId" jdbcType="INTEGER" />
		<result column="tcId" property="tcId" jdbcType="INTEGER" />
		<result column="projectId" property="projectId"
			jdbcType="INTEGER" />
		<result column="activityId" property="activityId"
			jdbcType="INTEGER" />
		<result column="location" property="location"
			jdbcType="VARCHAR" />
		<result column="startTime" property="startTime"
			jdbcType="VARCHAR" />
		<result column="endTime" property="endTime"
			jdbcType="VARCHAR" />
		<result column="workingHours" property="workingHours"
			jdbcType="DECIMAL" />
		<result column="status" property="status" jdbcType="VARCHAR" />
		<result column="onLeave" property="onLeave" jdbcType="VARCHAR" />
		<result column="taskDetails" property="taskDetails"
			jdbcType="VARCHAR" />
		<result column="addedOn" property="addedOn" jdbcType="DATE" />
		<result column="lastModifiedOn" property="lastModifiedOn"
			jdbcType="DATE" />
	</resultMap>

	<resultMap id="TimecardDayInfoViewMap" type="TimecardDayInfo">		
		<id column="tcId" property="tcId" jdbcType="INTEGER" />
		<id column="tcdId" property="tcdId" jdbcType="INTEGER" />
		<result column="workingdate" property="workingdate" jdbcType="DATE" />
	    <collection property="timecardDayDetails" column="tcId" javaType="ArrayList" ofType="TimecardDayDetails">
	    	<id property="tcId" column="tcId"/>
	    	<id property="tcdId" column="tcdId"/>
	    	<result property="projectId" column="projectId"/>
	    	<result property="activityId" column="activityId"/>
	    	<result property="location" column="location"/>
	    	<result property="taskDetails" column="taskDetails"/>
	    </collection>			
	</resultMap>


<!-- Insert data into table  TimecardInfo -->

	<insert id="addTimecardInfo" parameterType="TimecardInfo"
		useGeneratedKeys='true' keyProperty='tcId'>
		insert into TimecardInfo 
		(empId,weekStart,weekEnd,totalHours,status,addedOn)
		values
		(#{empId},
		#{weekStart},
		#{weekEnd},#{totalHours},#{status},now())
	</insert>
<!-- Insert Ended for table  TimecardInfo -->

<!-- Insert data into table  TimecardDayInfo -->

	<insert id="addIndividualTimecardDayInfo" parameterType="TimecardDayInfo"
		useGeneratedKeys='true' keyProperty='tcdId' keyColumn="tcdId">
		insert into
		TimecardDayInfo(tcId,workingDate,workingDay,
		totalWeekWorkHours,status,addedOn)
		values
			(#{tcId},#{workingDate}, #{workingDay}, #{totalWeekWorkHours},
			#{status}, now())
	</insert>

	<insert id="addBatchTimecardDayInfo" parameterType="list"
		useGeneratedKeys='true' keyProperty='tcdId' keyColumn="tcdId">
		insert into
		TimecardDayInfo(tcId,workingDate,workingDay,
		totalWeekWorkHours,status,addedOn)
		values
		<foreach collection="list" item="TimecardDayInfo"
			index="index" separator=",">
			(#{TimecardDayInfo.tcId},#{TimecardDayInfo.workingDate},#{TimecardDayInfo.workingDay},
			#{TimecardDayInfo.totalWeekWorkHours},#{TimecardDayInfo.status},now())
		</foreach>
	</insert>
<!-- Ended of Insert for table  TimecardDayInfo -->

<!-- Start of Insert data into table  TimecardDayDetails -->

	<insert id="addIndividualTimecardDayDetails" parameterType="TimecardDayDetails"
		useGeneratedKeys='true' keyProperty='tcddId' keyColumn="tcddId">
		insert into
		TimecardDayDetails(tcdId,tcId,projectId,activityId,location,startTime,endTime,workingHours,
		status,taskDetails,lastModifiedon)
		values
			(#{tcdId},#{tcId},#{projectId},#{activityId},#{location}
			,#{startTime},#{endTime},#{workingHours},#{status},#{taskDetails}, now())
	</insert>

	<insert id="addBatchTimecardDayDetails" parameterType="list"
		useGeneratedKeys='true' keyProperty='tcdId' keyColumn="tcdId">
		insert into
		TimecardDayDetails(tcdId,tcId,projectId,activityId,location,startTime,endTime,workingHours,
		status,taskDetails,addedOn)
		values

		<foreach collection="list" item="TimecardDayDetails"
			index="index" separator=",">

			(#{TimecardDayDetails.tcdId},#{TimecardDayDetails.tcId},#{TimecardDayDetails.projectId},
			#{TimecardDayDetails.activityId},#{TimecardDayDetails.location},
			#{TimecardDayDetails.startTime},#{TimecardDayDetails.endTime},
			#{TimecardDayDetails.workingHours},#{TimecardDayDetails.status},
			#{TimecardDayDetails.taskDetails}, now())
		</foreach>
	</insert>
<!-- Ended of Insert for table  TimecardDayDetai -->

