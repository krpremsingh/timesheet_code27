<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="TimecardInfo">

	<insert id="addTimecardInfo" useGeneratedKeys="true" keyProperty="id">
		insert into TimecardInfo (tcId, empId)
		values (#{tcId}, #{empId})
	</insert>

</mapper>
	