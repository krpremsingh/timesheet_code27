<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ReportMapper">

	<resultMap id="ReportMapper" type="ReportsInfo">
		<id column="tcId" property="tcId" jdbcType="INTEGER" />
		<result column="empId" property="empId" jdbcType="INTEGER" />
		<result column="weekStart" property="weekStart" jdbcType="DATE" />
		<result column="weekEnd" property="weekEnd" jdbcType="DATE" />
		<result column="totalHours" property="totalHours"
			jdbcType="VARCHAR" />	
		<result column="status" property="timcardStatus" jdbcType="VARCHAR" />
	</resultMap>
	
<select id="timecardsCount" parameterType="ReportsInfo" resultMap="ReportMapper">
select count(status) statusCount,status from TimecardInfo  where weekStart &gt;=#{weekStart} and weekEnd &lt;=#{weekEnd}  group by status;
</select>	

</mapper>