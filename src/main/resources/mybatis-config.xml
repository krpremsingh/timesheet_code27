<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>
<typeAliases>
	<typeAlias alias="User"
		type="com.awcsoftware.spring.security.auth.user.User" />

	<typeAlias alias="ConfirmationToken"
		type="com.awcsoftware.spring.security.auth.user.ConfirmationToken" />

	<typeAlias alias="TimecardInfo"
		type="com.awcsoftware.app.timesheet.TimecardInfo" />

	<typeAlias alias="TimecardDetails"
		type="com.awcsoftware.app.timesheet.TimecardDetails" />

	<typeAlias type="com.awcsoftware.app.common.BasePojo"
		alias="BasePojo" />

	<typeAlias type="com.awcsoftware.app.common.ParentBasePojo"
		alias="ParentBasePojo" />

	<typeAlias alias="TimeCardView"
		type="com.awcsoftware.app.timesheet.TimecardView" />

	<typeAlias alias="TCDBValidate"
		type="com.awcsoftware.app.timesheet.TimeCardDBValidate" />

	<typeAlias alias="TCTimeValidate"
		type="com.awcsoftware.app.timesheet.TimeCardTimeValidate" />

</typeAliases>
<environments default="development">
	<environment id="development">
			<transactionManager type="JDBC" />
			<dataSource type="POOLED">
				<property name="driver" value="com.mysql.jdbc.Driver" />
				<property name="url"
					value="jdbc:mysql://192.168.1.32:3306/timesheet" />
				<property name="username" value="root" />
				<property name="password" value="My@SQL" />
			</dataSource>
		</environment>
</environments>
<mappers>

<mapper resource="com/awcsoftware/app/timesheet/TimeCardRepositoryMapper.xml"/>

<mapper resource="com/awcsoftware/app/common/BaseRepositoryMapper.xml"/>

<mapper resource="com/awcsoftware/spring/security/auth/user/UserMapper.xml"/>

<!-- <mapper resource="com/awcsoftware/spring/password/user/UserPasswordMapper.xml" /> -->


</mappers>

</configuration>